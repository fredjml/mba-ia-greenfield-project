        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "VideoDetailsResponseDto": {
        "type": "object",
        "properties": {
          "videoId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "upload_initiated",
              "uploaded",
              "processing",
              "ready",
              "error",
              "upload_aborted"
            ]
          },
          "sizeBytes": {
            "type": "number",
            "nullable": true
          },
          "durationSeconds": {
            "type": "number",
            "nullable": true
          },
          "metadata": {
            "type": "object",
            "nullable": true
          },
          "processingError": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "videoId",
          "title",
          "slug",
          "status",
          "sizeBytes",
          "durationSeconds",
          "metadata",
          "processingError",
          "createdAt",
          "updatedAt"
        ]
      },
      "InitVideoUploadDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "My video",
            "minLength": 1,
            "maxLength": 120
          },
          "filename": {
            "type": "string",
            "example": "my-video.mp4",
            "minLength": 1,
            "maxLength": 255
          },
          "contentType": {
            "type": "string",
            "example": "video/mp4",
            "minLength": 1,
            "maxLength": 100
          },
          "sizeBytes": {
            "type": "number",
            "example": 10485760,
            "minimum": 1
          },
          "parts": {
            "type": "number",
            "example": 2,
            "minimum": 1
          }
        },
        "required": [
          "title",
          "filename",
          "contentType",
          "sizeBytes",
          "parts"
        ]
      },
      "UploadPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "example": "http://localhost:9000/bucket/key?..."
          }
        },
        "required": [
          "partNumber",
          "url"
        ]
      },
      "InitVideoUploadResponseDto": {
        "type": "object",
        "properties": {
          "videoId": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "example": "my-video-a1b2c3d4e5f6"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "upload_initiated",
              "uploaded",
              "processing",
              "ready",
              "error",
              "upload_aborted"
            ]
          },
          "uploadId": {
            "type": "string"
          },
          "partSize": {
            "type": "number",
            "example": 10485760
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadPartDto"
            }
          }
        },
        "required": [
          "videoId",
          "slug",
          "status",
          "uploadId",
          "partSize",
          "parts"
        ]
      },
      "CompletedVideoPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "number",
            "example": 1,
            "minimum": 1,
            "maximum": 10000
          },
          "etag": {
            "type": "string",
            "example": "\"d41d8cd98f00b204e9800998ecf8427e\""
          }
        },
        "required": [
          "partNumber",
          "etag"
        ]
      },
      "CompleteVideoUploadDto": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string",
            "example": "multipart-upload-id",
            "minLength": 1,
            "maxLength": 256
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompletedVideoPartDto"
            }
          }
        },
        "required": [
          "uploadId",
          "parts"
        ]
      },
      "VideoUploadStatusResponseDto": {
        "type": "object",
        "properties": {
          "videoId": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "upload_initiated",
              "uploaded",
              "processing",
              "ready",
              "error",
              "upload_aborted"
            ]
          }
        },
        "required": [
          "videoId",
          "slug",
          "status"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}